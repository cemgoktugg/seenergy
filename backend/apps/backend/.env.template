# Copy to .env and fill in. .env is gitignored; this template is not.
MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3100,http://localhost:9000,http://localhost:5173
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/seenergy
DB_NAME=seenergy
# Product images are served by the storefront; the seed writes absolute URLs.
STOREFRONT_URL=http://localhost:3100
# Shared with the storefront's REVALIDATE_SECRET: lets admin saves refresh the site at once.
STOREFRONT_REVALIDATE_SECRET=

# This server's public address, no trailing slash (https://api.example.com.tr).
# Uploaded pictures are stored with this base; unset = http://localhost:9000.
MEDUSA_BACKEND_URL=

# TicariCore (NetHesap) ERP: brands, categories, products, prices and stock of
# one sales channel come in every 15 minutes (src/jobs/ticaricore-catalog.ts).
# All three unset = the integration is off. Never commit the key.
TICARICORE_URL=https://demo.nethesaponline.com
TICARICORE_API_KEY=
# The "websitesi" channel's uid (GET /api/v1/channels).
TICARICORE_CHANNEL_UID=
# Prefix of the order number sent as TicariCore's customerRef (WEB-12). Use a
# different one on any server that shares the TicariCore tenant (TEST-).
TICARICORE_ORDER_PREFIX=WEB-
