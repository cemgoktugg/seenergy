{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/visual/quality-gate-hook.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run visual:*)",
      "Bash(npm run quality:*)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/visual/*)"
    ]
  }
}
