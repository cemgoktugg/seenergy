# Dokploy → seenergy (Compose) → Environment. Every key the compose file
# reads; the filled-in copy with generated secrets is deploy/.env.dokploy.local
# (not in git). Values with no default must be set.

# Domains — the store, and the backend + admin (admin at https://API_DOMAIN/app)
DOMAIN=ecommercore.com.tr
API_DOMAIN=api.ecommercore.com.tr

# Postgres inside the compose. Use a hex password: it goes into a URL, where
# characters like @ : / would break it.
POSTGRES_DB=seenergy
POSTGRES_USER=seenergy
POSTGRES_PASSWORD=

# Long random strings
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# Shared by the backend (to ask for a refresh) and the store (to accept it)
REVALIDATE_SECRET=

# The admin login, created on the first start. Remove ADMIN_PASSWORD once you
# have logged in, so the password does not stay in the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The store's publishable key (in the restored database; public by design)
MEDUSA_PUBLISHABLE_KEY=pk_11ce8aef229a358bc58bce50360456b85790a7113cfe2e62a0e4ca6a8c0c1e33

# Havale / EFT details shown at checkout (optional)
BANK_NAME=
BANK_HOLDER=
BANK_IBAN=

# TicariCore ERP: brands, categories, products, prices and stock of the
# "websitesi" channel, every 15 minutes. All three empty = off. Never commit the key.
TICARICORE_URL=https://demo.nethesaponline.com
TICARICORE_API_KEY=
TICARICORE_CHANNEL_UID=01a1610a-e977-7225-ba04-ff7e383f909e
