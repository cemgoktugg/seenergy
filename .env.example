# Storefront → Medusa. Copy to .env.local. Server-side only: neither value is
# NEXT_PUBLIC_, so neither is ever shipped to the browser.
MEDUSA_BACKEND_URL=http://localhost:9000
# The seed prints it ("Publishable key: pk_..."); also in Admin → Settings → Publishable API Keys.
MEDUSA_PUBLISHABLE_KEY=

# Havale / EFT details shown on the order confirmation. Leave BANK_IBAN empty
# until the real account is known: the page then says the details follow by
# e-mail instead of printing a placeholder someone might pay into.
BANK_NAME=
BANK_HOLDER=
BANK_IBAN=

# Same value as the backend's STOREFRONT_REVALIDATE_SECRET. Lets a save in the
# Medusa admin refresh the site immediately instead of within 60 seconds.
REVALIDATE_SECRET=
