# Dependencies
node_modules/

# Environment — the .example file is committed, real values are not
.env
.env.*
!.env.visual.example
!.env.example
!backend/apps/backend/.env.template

# Generated visual artifacts: screenshots, diffs, traces, reports.
# The directory skeleton is kept via .gitkeep files.
artifacts/visual/reference/*
artifacts/visual/local/*
artifacts/visual/diff/*
artifacts/visual/reports/*
artifacts/visual/test-results/
# Scratch capture directories: Playwright's reference project and any
# determinism / A-B run created with `--out`.
artifacts/visual/reference-live/
artifacts/visual/_*
!artifacts/visual/**/.gitkeep

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# OS / editor noise
Thumbs.db
.DS_Store

# Next.js build output
.next/
*.tsbuildinfo
next-env.d.ts

# Reference-site captures and analysis screenshots: regenerable with the
# scripts/visual probes, large, and they contain the reference site's imagery.
reference/
reference-analysis/

# Medusa backend
.medusa/
.turbo/
backend/apps/backend/uploads/
# static/ is NOT ignored: it holds the pictures uploaded in the admin (Medusa's
# local file provider), which are site content the server needs — committed
# for the move to the Veridyen server along with deploy/seenergy.sql.

# The client's CCTV source folder (images, datasheets, .ai files — ~450 MB).
# Its web-ready output is generated elsewhere; the originals stay local.
/src/CCTV/
